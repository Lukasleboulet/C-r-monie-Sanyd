# Modèle du fichier .env (à copier en « .env » à côté de server.js). Ne jamais mettre le vrai .env sur GitHub.

# Adresse publique du site (sert aux redirections). Ex. : https://samp.fbfa.fr
BASE_URL=

# Hôte FolkOS (<HÔTE_FOLKOS> dans REGLES-DEV.md). Ex. : https://computer.game.fbfa.fr
# -> charge fbfa-game.js (clavier en jeu) et fbfa-bridge.js (barre d'adresse)
FOLKOS_HOST=

# « Se connecter IG » (fournis par FolkOS, côté serveur uniquement)
FOLKOS_ID_BASE=
FOLKOS_CLIENT_ID=
FOLKOS_CLIENT_SECRET=

# Connexion Discord classique (navigateur hors jeu), facultatif
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Facultatif : port d'écoute et dossier des données
# PORT=3000
# DATA_DIR=/chemin/vers/data
